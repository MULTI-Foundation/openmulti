# OpenMulti v0 configuration

# Upstream provider (OpenRouter, OpenAI-compatible). Required.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Identity sent to the upstream provider (attribution headers).
OPENMULTI_REFERER=https://openmulti.ai
OPENMULTI_TITLE=OpenMulti

# Direct access paths (docs/MULTI-PROVIDER-SPEC.md §4) — all optional. Requires the
# vendor's key (missing key = silent OpenRouter fallback, the iso default).
#   direct = the vendor's models always go direct (deterministic)
#   smart  = path bandit (spec step 4): explore/exploit between direct and OpenRouter
#            on observed cost/health per path, same knobs as the tier bandit
# OPENMULTI_PROVIDER_MOONSHOTAI=smart
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Server
PORT=8080

# API keys allowed to call OpenMulti, comma-separated (v0: static allowlist).
# Each consuming project (e.g. MyMULTI) gets its own sk_ key.
# Example: sk_mymulti_xxx,sk_otherproject_yyy
OPENMULTI_API_KEYS=

# Max retries on a transient upstream failure (same model, 429/5xx + connect errors).
# 0 disables. Only ever retries before any byte reaches the client.
OPENMULTI_MAX_RETRIES=2
# When the elected access path exhausts its retries and the model has another path
# (e.g. moonshot direct <-> openrouter), fail over to it — same model, answer
# preserved. On by default; set to 0 to disable.
# OPENMULTI_PATH_FALLBACK=0

# --- Security hardening (all opt-in; see docs/SECURITY-AUDIT-2026-06-08.md) ---
# OM-02: reject requests whose body exceeds this many bytes. 0 = unlimited.
OPENMULTI_MAX_BODY_BYTES=8388608
# OM-01: per-key request rate limit over a 60s window. 0 = disabled.
OPENMULTI_RATE_LIMIT_PER_MIN=0
# OM-01: per-tier ceiling on max_tokens to bound unit cost (unset/0 = none).
# OPENMULTI_MAX_TOKENS_ECONOMY=
# OPENMULTI_MAX_TOKENS_BALANCED=
# OPENMULTI_MAX_TOKENS_QUALITY=
# OM-03: dedicated ops token for GET /metrics. Empty = caller-key auth (current).
# Set it (and use it as the Prometheus bearer_token) to stop cross-tenant reads.
# Also guards /admin/* (durable metering reads) — strictly required there.
OPENMULTI_METRICS_TOKEN=

# Durable per-key metering (billing substrate, docs/PRODUCT-V1.md). Redis/Valkey URL;
# empty = disabled (no behavior change). Writes are fire-and-forget: a Redis outage
# never breaks a call (drops are counted in openmulti_meter_dropped_total).
REDIS_URL=

# Tier -> model catalog overrides (optional). If unset, defaults in src/catalog.ts apply.
# This is where you change "which model is the economy/balanced/quality text model"
# WITHOUT touching any consuming project.
OPENMULTI_MODEL_ECONOMY=anthropic/claude-haiku-4-5
OPENMULTI_MODEL_BALANCED=anthropic/claude-sonnet-4-5
OPENMULTI_MODEL_QUALITY=anthropic/claude-opus-4-1

# v1 routing: candidate sets + selection strategy (opt-in, default = iso behavior).
# Provide a full candidate set per tier with the plural form (comma-separated, the
# FIRST is the iso primary). Overrides the single-model env above.
# OPENMULTI_MODELS_BALANCED=anthropic/claude-sonnet-4-5,moonshotai/kimi-k2.6
# Strategy: 'default' = first candidate; 'smart' = pick by observed cost/health.
# Per-request override via openmulti.route. Global default below.
OPENMULTI_DEFAULT_ROUTE=default
OPENMULTI_SMART_MIN_SAMPLES=10
OPENMULTI_SMART_MAX_ERROR_RATE=0.2
# Bandit horizon, in requests: observed stats decay by 1-1/window per observation,
# so 'smart' weighs the recent past, keeps re-sampling losing candidates
# (~MIN_SAMPLES/window of the traffic) and lets a degraded model recover.
# 0 = lifetime stats (explore once, exploit forever — the pre-bandit behavior).
OPENMULTI_SMART_DECAY_WINDOW=200
OPENMULTI_MODEL_IMAGE=google/gemini-2.5-flash-image
# Default model for POST /v1/embeddings when the caller sends model:'auto'.
OPENMULTI_MODEL_EMBEDDING=openai/text-embedding-3-small

# Per-model price overrides (USD per MTok), JSON. Feeds usage.cost synthesis for the
# future DIRECT providers (docs/MULTI-PROVIDER-SPEC.md §5) — inert on the OpenRouter
# path, which reports its own cost. Unknown model = no cost, never a fake zero.
# OPENMULTI_PRICING_JSON={"vendor/model":{"inputPerMTok":3,"outputPerMTok":15}}

# Routing par tache (purpose-aware). Pour purpose=agent (code long, containers
# OpenClaw) on route vers un modele de code plutot que le defaut du tier.
OPENMULTI_MODEL_AGENT_BALANCED=moonshotai/kimi-k2.6
OPENMULTI_MODEL_AGENT_QUALITY=moonshotai/kimi-k2.6
