# OpenMulti v0 configuration

# Upstream provider (OpenRouter, OpenAI-compatible). Required.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Identity sent to the upstream provider (attribution headers).
OPENMULTI_REFERER=https://openmulti.ai
OPENMULTI_TITLE=OpenMulti

# Direct access paths (docs/MULTI-PROVIDER-SPEC.md §4) — all optional. Requires the
# vendor's key (missing key = silent OpenRouter fallback, the iso default).
#   direct = the vendor's models always go direct (deterministic)
#   smart  = path bandit (spec step 4): explore/exploit between direct and OpenRouter
#            on observed cost/health per path, same knobs as the tier bandit
# OPENMULTI_PROVIDER_MOONSHOTAI=smart
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Autres chemins directs OpenAI-compatibles (endpoints/ids/prix verifies 2026-06-22).
# Chacun s'active avec OPENMULTI_PROVIDER_<VENDOR>=direct|smart ET sa cle ; cle absente
# = fallback silencieux sur OpenRouter. 'smart' = le bandit arbitre direct vs OpenRouter
# au cout/sante observes (recommande). Le prefixe est l'id CATALOGUE (style OpenRouter) :
# openai/, deepseek/, mistralai/, z-ai/, qwen/.
# OPENMULTI_PROVIDER_OPENAI=smart
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENMULTI_PROVIDER_DEEPSEEK=smart
DEEPSEEK_API_KEY=
# OPENMULTI_PROVIDER_MISTRALAI=smart
MISTRAL_API_KEY=
# OPENMULTI_PROVIDER_ZAI=smart
ZAI_API_KEY=
# OPENMULTI_PROVIDER_QWEN=smart   # Alibaba DashScope (international/Singapour)
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Anthropic DIRECT (seul provider NON OpenAI-shape : traduction /v1/messages). Préfixe
# catalogue 'anthropic/'. max_tokens est requis côté Anthropic -> défaut si l'appelant
# ne le pose pas.
# OPENMULTI_PROVIDER_ANTHROPIC=smart
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01
# OPENMULTI_ANTHROPIC_DEFAULT_MAX_TOKENS=8192

# Server
PORT=8080

# API keys allowed to call OpenMulti, comma-separated (v0: static allowlist).
# Each consuming project (e.g. MyMULTI) gets its own sk_ key.
# Example: sk_mymulti_xxx,sk_otherproject_yyy
OPENMULTI_API_KEYS=

# Max retries on a transient upstream failure (same model, 429/5xx + connect errors).
# 0 disables. Only ever retries before any byte reaches the client.
OPENMULTI_MAX_RETRIES=2
# When the elected access path exhausts its retries and the model has another path
# (e.g. moonshot direct <-> openrouter), fail over to it — same model, answer
# preserved. On by default; set to 0 to disable.
# OPENMULTI_PATH_FALLBACK=0

# --- Security hardening (all opt-in; audit kept in the private openmulti-ops repo) ---
# OM-02: reject requests whose body exceeds this many bytes. 0 = unlimited.
OPENMULTI_MAX_BODY_BYTES=8388608
# OM-01: per-key request rate limit over a 60s window. 0 = disabled. With REDIS_URL
# set, the counter is shared across replicas (Valkey); store down = per-pod fallback.
OPENMULTI_RATE_LIMIT_PER_MIN=0
# OM-01: per-tier ceiling on max_tokens to bound unit cost (unset/0 = none).
# OPENMULTI_MAX_TOKENS_ECONOMY=
# OPENMULTI_MAX_TOKENS_BALANCED=
# OPENMULTI_MAX_TOKENS_QUALITY=
# OM-06: extend the upstream field allowlist without a release (CSV). Unknown request
# fields are otherwise stripped before forwarding (counted + logged once per name).
# OPENMULTI_ALLOWED_EXTRA_FIELDS=
# OM-03: dedicated ops token for GET /metrics. Empty = caller-key auth (current).
# Set it (and use it as the Prometheus bearer_token) to stop cross-tenant reads.
# Also guards /admin/* (durable metering reads) — strictly required there.
OPENMULTI_METRICS_TOKEN=

# B2: self-service signup (agent-native onboarding). OPT-IN — off by default. Requires
# REDIS_URL (fail-closed) and, in prod, a real email provider. Flow: POST /signup
# {email} -> emailed code -> POST /signup/verify {email, code} -> project + sk_ key
# with a tiny daily cap (raise later via PUT /admin/caps/:project). Guards: per-IP
# rate limit, global daily send cap, hashed single-use codes, anti-enumeration.
# OPENMULTI_SIGNUP=1
# OPENMULTI_SIGNUP_CAP_USD=0.1
# OPENMULTI_SIGNUP_PER_DAY=50
# OPENMULTI_SIGNUP_RATE_PER_MIN=3
# B3 zero-advance posture: signup projects with no credits get 402 (prepaid-only,
# disables the capped free trial). Signup projects are always FAIL-CLOSED: store
# down = 503 for them, while trusted keys keep the historical fail-open.
# OPENMULTI_SIGNUP_REQUIRE_CREDITS=1
# B4: x402 payment rail (per-request USDC payments for anonymous wallet agents).
# STRICT opt-in — without OPENMULTI_X402=1 the gate is a pass-through. Flow: keyless
# POST /v1/chat/completions -> 402 with a bound max quote -> agent signs EIP-3009 ->
# retries with X-PAYMENT -> verify+settle via the facilitator -> wallet project
# credited (overpay stays as balance) -> request executed. Testnet first:
# base-sepolia + the public facilitator; mainnet = your multisig + CDP facilitator.
# OPENMULTI_X402=1
# OPENMULTI_X402_PAY_TO=0x...            # receiving address (the Safe multisig)
# OPENMULTI_X402_NETWORK=base-sepolia    # or 'base' (mainnet)
# OPENMULTI_X402_FACILITATOR_URL=https://x402.org/facilitator
# OPENMULTI_X402_FACILITATOR_TOKEN=      # auth token if the facilitator needs one
# Extra AUDIT verifiers (CSV of facilitator base URLs): a payment must be validated by
# the primary AND every auditor (cross-verification, fail-closed). Settle stays on the
# primary. E.g. a self-hosted Mogami next to Dexter.
# OPENMULTI_X402_VERIFY_URLS=http://mogami:8080
# OPENMULTI_X402_QUOTE_SECRET=           # HMAC secret for bound quotes (required)
# OPENMULTI_X402_QUOTE_TTL_S=300
# OPENMULTI_X402_USDC=                   # USDC contract override (else known table)
# Facilitator timeouts: verify is a read (short); settle submits a tx on-chain and is
# much slower on mainnet (a 20s budget timed out on the first real mainnet settle).
# OPENMULTI_X402_VERIFY_TIMEOUT_MS=20000
# OPENMULTI_X402_SETTLE_TIMEOUT_MS=60000
# Coinbase CDP as the PRIMARY facilitator (gas-sponsored settle on Base mainnet +
# compliance screening). Takes precedence over OPENMULTI_X402_FACILITATOR_URL when both
# creds are set. Create a Secret API Key at portal.cdp.coinbase.com.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Public top-up link template ({project} is substituted). Exposed in GET /v1/balance
# and appended to 402 insufficient_credits errors, so an agent can hand its human a
# payment link. Empty = no URL in responses.
# OPENMULTI_TOPUP_URL=https://console.openmulti.ai/api/topup?project={project}
# Email provider: 'log' (default — the code goes to the logs, dev/staging only) or
# 'resend' (RESEND_API_KEY required; from must be a verified domain).
# OPENMULTI_EMAIL_PROVIDER=resend
# OPENMULTI_EMAIL_FROM=onboarding@openmulti.ai
# RESEND_API_KEY=

# Revenue model: default margin on tokens, in percent — clients pay cost x (1+t/100)
# via usage.cost and the billable metering (billed_usd). 0 = byte-identical passthrough
# (the code default). Per-project override: PUT /admin/margins/:project (e.g. 0 for an
# internal caller that has its own billing).
# OPENMULTI_MARGIN_PCT=20
# Durable per-key metering (billing substrate, docs/PRODUCT-V1.md). Redis/Valkey URL;
# empty = disabled (no behavior change). Writes are fire-and-forget: a Redis outage
# never breaks a call (drops are counted in openmulti_meter_dropped_total).
REDIS_URL=

# The REAL tier->models mapping is operating config, never committed (it is part of
# OpenMulti's value). Point this at a local JSON file (see catalog.example.json for
# the format; catalog.local.json is gitignored). In-cluster it is mounted from a
# ConfigMap created out-of-band. Per-slot precedence:
#   admin override (PUT /admin/catalog/:slot, hot) > this file > env > neutral defaults
OPENMULTI_CATALOG_FILE=catalog.local.json
# Env overrides remain for quick single-slot tweaks (plural = full set; singular
# replaces a whole set with ONE model, which starves the bandit):
# OPENMULTI_MODELS_BALANCED=vendor/model-a,vendor/model-b
# OPENMULTI_MODEL_QUALITY=vendor/model

# v1 routing: candidate sets + selection strategy (opt-in, default = iso behavior).
# Provide a full candidate set per tier with the plural form (comma-separated, the
# FIRST is the iso primary). Overrides the single-model env above.
# OPENMULTI_MODELS_BALANCED=anthropic/claude-sonnet-4-5,moonshotai/kimi-k2.6
# Strategy: 'default' = first candidate; 'smart' = pick by observed cost/health.
# Per-request override via openmulti.route. Global default below.
OPENMULTI_DEFAULT_ROUTE=default
OPENMULTI_SMART_MIN_SAMPLES=10
OPENMULTI_SMART_MAX_ERROR_RATE=0.2
# Bandit horizon, in requests: observed stats decay by 1-1/window per observation,
# so 'smart' weighs the recent past, keeps re-sampling losing candidates
# (~MIN_SAMPLES/window of the traffic) and lets a degraded model recover.
# 0 = lifetime stats (explore once, exploit forever — the pre-bandit behavior).
OPENMULTI_SMART_DECAY_WINDOW=200
OPENMULTI_MODEL_IMAGE=google/gemini-2.5-flash-image
# Default model for POST /v1/embeddings when the caller sends model:'auto'.
OPENMULTI_MODEL_EMBEDDING=openai/text-embedding-3-small

# Per-model price overrides (USD per MTok), JSON. Feeds usage.cost synthesis for the
# future DIRECT providers (docs/MULTI-PROVIDER-SPEC.md §5) — inert on the OpenRouter
# path, which reports its own cost. Unknown model = no cost, never a fake zero.
# OPENMULTI_PRICING_JSON={"vendor/model":{"inputPerMTok":3,"outputPerMTok":15}}

# Routing par tache (purpose-aware). Pour purpose=agent (code long, containers
# OpenClaw) on route vers un modele de code plutot que le defaut du tier.
OPENMULTI_MODEL_AGENT_BALANCED=moonshotai/kimi-k2.6
OPENMULTI_MODEL_AGENT_QUALITY=moonshotai/kimi-k2.6

# Council / fusion (mixture-of-agents) — opt-in via openmulti.council ou model:'council'.
# Un panel répond en parallèle (via nos chemins directs), puis un chair synthétise. Coût
# = N+1 (fuse) ou 2N+1 (deliberate) appels. Les panels sont de la config d'exploitation
# (comme le catalogue), toujours surchargeables par requête (openmulti.council.panel).
# Vides = council utilisable seulement avec panel+chair explicites dans la requête.
# OPENMULTI_COUNCIL_CHAIR=anthropic/claude-opus-4-8
# OPENMULTI_COUNCIL_DEFAULT_PRESET=quality
# OPENMULTI_COUNCIL_PANEL_QUALITY=anthropic/claude-sonnet-4-6,openai/gpt-4.1,deepseek/deepseek-chat
# OPENMULTI_COUNCIL_PANEL_BUDGET=deepseek/deepseek-chat,mistralai/mistral-small-latest,qwen/qwen-plus,z-ai/glm-4.6
# Preset « flash » : uniquement des modèles rapides (faible latence) -> réponse plus vite.
# Chair flash = synthétiseur rapide (sinon retombe sur OPENMULTI_COUNCIL_CHAIR).
# OPENMULTI_COUNCIL_PANEL_FLASH=deepseek/deepseek-chat,mistralai/mistral-small-latest,openai/gpt-4o-mini
# OPENMULTI_COUNCIL_CHAIR_FLASH=anthropic/claude-haiku-4-5
